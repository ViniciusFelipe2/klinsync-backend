{
  "name": "klinsync-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-schema": "node scripts/sync-schema.mjs",
    "create-master": "node --env-file-if-exists=.env dist/cli/create-master.js",
    "local:dev": "tsx --env-file-if-exists=.env.local tools/dev-local.ts",
    "local:import": "tsx --env-file-if-exists=.env.import tools/importar-local.ts",
    "local:dump": "tsx tools/dump-local.ts",
    "local:seed": "tsx tools/seed-demo.ts",
    "local:reset": "node -e \"require('fs').rmSync('.local-db',{recursive:true,force:true});console.log('banco local apagado')\"",
    "local:smoke": "tsx tools/smoke-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-tools": "^0.4.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
