# Copie para .env.import (fica fora do Git) e preencha. Usado por `npm run local:import`.
# NUNCA coloque valores reais neste arquivo de exemplo: ele vai para o Git.

# Obrigatório: string de conexão Postgres do Supabase.
# Supabase Dashboard > Settings > Database > Connection string. Use "Direct connection" ou "Session pooler" (porta 5432).
# A importação só LÊ o Supabase (a conexão é aberta em modo somente leitura).
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres

# Só para copiar as fotos de check-in (Storage do Supabase -> S3):
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CHECKIN_PHOTOS_BUCKET=klinsync-checkin-fotos
