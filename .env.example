# Copie para .env (desenvolvimento). Em produção as variáveis vêm de /etc/klinsync/backend.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Postgres do klinsync-db
DATABASE_URL=postgresql://klinsync_app:SENHA@127.0.0.1:5432/klinsync
DB_POOL_MAX=10

# Segredos (>= 32 caracteres). Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Cifra os segredos TOTP (MFA). Se vazio, deriva de JWT_REFRESH_SECRET (trocar este segredo invalidaria os MFAs)
MFA_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# reCAPTCHA v3 (vazio = captcha desativado)
RECAPTCHA_SECRET_KEY=

# Bucket S3 privado das fotos de check-in (vazio = check-in indisponível)
CHECKIN_PHOTOS_BUCKET=
AWS_REGION=us-east-2

# Proxy confiável para ler o IP real (Nginx local)
TRUST_PROXY=loopback
# Fuso do hospital: define "hoje" e os limites de dia dos filtros por período
APP_TIMEZONE=America/Sao_Paulo
GEOIP_ENABLED=true
HIBP_ENABLED=true
LOG_LEVEL=info
